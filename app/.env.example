# SQL Server connection (no real secrets - copy to .env and fill)
DB_SERVER=localhost\\SQLEXPRESS
# Optional fixed TCP port (recommended when SQL Browser is unavailable)
DB_PORT=
DB_DATABASE=BadmintonCourtManagement
DB_USER=bcm_app
DB_PASSWORD=__CHANGE_ME_APP_SQL_PASSWORD__
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000

# App web session (signed by this secret in dev)
SESSION_SECRET=__CHANGE_ME_SESSION_SECRET__

# Server
APP_PORT=3000

# Vite dev server
VITE_DEV_PORT=5173

# Optional SMTP Email Service (for password recovery OTP emails)
# If left empty in development, OTP codes are returned directly in the dev response.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BadmintonPro <no-reply@badmintonpro.local>
