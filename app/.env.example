# SQL Server connection (no real secrets - copy to .env and fill)
DB_SERVER=localhost\SQLEXPRESS
# Có thể dùng DB_SERVER=localhost + cổng TCP cố định để không phụ thuộc SQL Browser.
DB_PORT=
DB_DATABASE=BadmintonCourtManagement
DB_USER=bcm_app
DB_PASSWORD=__CHANGE_ME_APP_SQL_PASSWORD__
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
# Chong qua tai (IMP-10/11): -1 = cho khoa vo han nhu mac dinh SQL Server
DB_LOCK_TIMEOUT_MS=5000
# Tran so phien dang nhap dong thoi (moi phien giu 1 connection SQL); 0 = khong gioi han
MAX_SESSION_CONNECTIONS=200
# So lan POST /api/auth/login moi phut cho 1 IP; 0 = tat
LOGIN_RATE_LIMIT_PER_MINUTE=60
# Register + forgot/reset password requests per IP per minute
AUTH_MUTATION_RATE_LIMIT_PER_MINUTE=10

# Email khôi phục mật khẩu. Có thể để trống khi chạy local; mã demo sẽ hiện trên giao diện.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false và dùng App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BadmintonPro <no-reply@example.com>

# App web session (signed by this secret in dev)
SESSION_SECRET=__CHANGE_ME_SESSION_SECRET__
# Shared absolute TTL for the cookie and its dedicated SQL connection (8h)
SESSION_TTL_MS=28800000
# Close an authenticated SQL connection after 30 minutes without a request
SESSION_IDLE_TIMEOUT_MS=1800000
# Scan for abandoned/expired SQL sessions every 60 seconds
SESSION_SWEEP_INTERVAL_MS=60000

# Server
APP_PORT=3000

# Vite dev server
VITE_DEV_PORT=5173
