{
  "name": "badminton-court-management-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BadmintonCourtManagement Phase 2 application (TypeScript + Express + React + SQL Server)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:server && tsc -p tsconfig.client.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test tests/authValidation.test.ts tests/rateLimit.test.ts tests/retry.test.ts tests/sessionExpiry.test.ts tests/spError.test.ts tests/time.test.ts",
    "start": "node dist/server/index.js --serve-client",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mssql": "^11.0.1",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0"
  }
}
